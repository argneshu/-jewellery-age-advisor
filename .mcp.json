{
  "mcpServers": {
    "atlassian-rovo": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp"
      ]
    },
    "helix": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://helix-mcp.3pillarglobal.com/helix-atlas/mcp",
        "8765",
        "--header",
        "x-solution-id:1080",
        "--static-oauth-client-info",
        "{\"client_id\":\"helix-local-mcp-agent\"}"
      ]
    }
  }
}